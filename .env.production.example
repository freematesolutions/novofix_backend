# =============================================================================
# NOVOFIX — PLANTILLA DE VARIABLES DE ENTORNO PARA PRODUCCIÓN (Render)
# =============================================================================
# Copia este archivo en el dashboard de Render → Environment, o crea un
# .env.production local (NUNCA lo subas a git) y reemplaza los valores REPLACE_*.
#
# Documentación interna:
#   - EMAIL_VALIDATION_SOLUTION.md
#   - SEO_VERCEL_RENDER_CONFIG.md
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# ENTORNO
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# URL pública del frontend (Vercel) — usada para links en emails y CORS
FRONTEND_URL=https://novofixfrontendprod.vercel.app

# Dominio canónico (sin slash final) para SEO (sitemap.xml, robots.txt)
PUBLIC_SITE_URL=https://novofix.com


# ─────────────────────────────────────────────────────────────────────────────
# BASE DE DATOS
# ─────────────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/marketplace_prod?retryWrites=true&w=majority


# ─────────────────────────────────────────────────────────────────────────────
# AUTENTICACIÓN Y SEGURIDAD
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING_MIN_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_SECURE_RANDOM_STRING
JWT_EXPIRES_IN=30d
BCRYPT_ROUNDS=12


# ─────────────────────────────────────────────────────────────────────────────
# EMAIL — VERIFICACIÓN Y NOTIFICACIONES (SendGrid)
# ─────────────────────────────────────────────────────────────────────────────
# Pasos para configurar SendGrid en producción:
#   1. Crear cuenta gratuita: https://signup.sendgrid.com
#   2. Verificar Single Sender: https://app.sendgrid.com/settings/sender_auth/senders
#      → debe coincidir EXACTAMENTE con SENDGRID_FROM_EMAIL
#   3. Crear API Key con permiso "Mail Send → Full Access":
#      https://app.sendgrid.com/settings/api_keys
#   4. Cuando tengas dominio propio, configurar Domain Authentication
#      (SPF + DKIM + DMARC) para mejorar entregabilidad y evitar SPAM.

# Modo de envío. Valores válidos (en minúsculas):
#   sendgrid  → API SendGrid (RECOMENDADO en Render Free, 100 emails/día)
#   resend    → API Resend (requiere dominio verificado)
#   smtp      → Gmail SMTP (BLOQUEADO en Render Free, solo Starter)
#   hybrid    → SendGrid → Resend → SMTP → consola (fallback automático)
#   console   → Solo imprime en consola (NO usar en producción)
EMAIL_MODE=sendgrid

# Modo demo: si es 'true' omite envío real y muestra el link en la UI.
# IMPORTANTE: en NODE_ENV=production se fuerza a 'false' aunque esté en 'true'.
AUTO_VERIFY_EMAIL=false

# Tiempo de expiración del token de verificación (horas)
EMAIL_VERIFICATION_TTL_HOURS=24

# SendGrid
SENDGRID_API_KEY=SG.REPLACE_WITH_YOUR_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=freematesolutions@gmail.com

# Remitente y marca visibles para el usuario
# (EMAIL_FROM debe coincidir con SENDGRID_FROM_EMAIL si usas SendGrid)
EMAIL_FROM=freematesolutions@gmail.com
EMAIL_FROM_NAME=NovoFix
APP_NAME=NovoFix

# Resend (opcional, fallback futuro)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Gmail SMTP (opcional, requiere plan Render Starter)
# Activar 2FA + crear App Password: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=


# ─────────────────────────────────────────────────────────────────────────────
# CLOUDINARY (Almacenamiento de imágenes y videos)
# ─────────────────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=REPLACE_WITH_CLOUD_NAME
CLOUDINARY_API_KEY=REPLACE_WITH_API_KEY
CLOUDINARY_API_SECRET=REPLACE_WITH_API_SECRET
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
MAX_UPLOAD_CONCURRENCY=3


# ─────────────────────────────────────────────────────────────────────────────
# STRIPE (Pagos y suscripciones)
# ─────────────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_PRODUCTION_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_REAL_WEBHOOK_SECRET
STRIPE_PRICE_EXPERT=price_REPLACE_WITH_EXPERT_PRICE_ID
STRIPE_PRICE_ELITE=price_REPLACE_WITH_ELITE_PRICE_ID

# Modo promocional: 'true' = todos los planes con acceso completo, 'false' = restricciones reales
FREE_PLAN_PROMO=true


# ─────────────────────────────────────────────────────────────────────────────
# REDIS (Caché y sesiones)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://REPLACE_WITH_REDIS_HOST:PORT
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD
REDIS_CACHE_TTL_PROVIDERS=300
REDIS_CACHE_TTL_SESSIONS=3600
REDIS_CACHE_TTL_REQUESTS=600


# ─────────────────────────────────────────────────────────────────────────────
# WHATSAPP BUSINESS API (Opcional)
# ─────────────────────────────────────────────────────────────────────────────
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=


# ─────────────────────────────────────────────────────────────────────────────
# RATE LIMITING Y UPLOADS
# ─────────────────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
UPLOAD_MAX_FILE_SIZE=10485760
UPLOAD_MAX_FILES=5


# ─────────────────────────────────────────────────────────────────────────────
# CONFIGURACIÓN DE NEGOCIO
# ─────────────────────────────────────────────────────────────────────────────
# Multiplicadores de visibilidad por plan
VISIBILITY_MULTIPLIER_FREE=1.0
VISIBILITY_MULTIPLIER_EXPERT=1.5
VISIBILITY_MULTIPLIER_ELITE=2.0

# Programa de referidos (promocional)
REFERRAL_DAYS_PER_SIGNUP=7
REFERRAL_MAX_DAYS=30
# Fecha de expiración (ISO 8601). Vacío = sin expiración.
# Ejemplo: REFERRAL_PROGRAM_END_DATE=2026-12-31T23:59:59Z
REFERRAL_PROGRAM_END_DATE=


# ─────────────────────────────────────────────────────────────────────────────
# ADMINISTRADOR POR DEFECTO (solo si la BD está vacía)
# ─────────────────────────────────────────────────────────────────────────────
DEFAULT_ADMIN_NAME=Administrador
DEFAULT_ADMIN_EMAIL=admin@novofix.com
DEFAULT_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
